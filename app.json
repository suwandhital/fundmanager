{
  "expo": {
    "name": "Suwan's FundManager",
    "slug": "fundmanager-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://fundmanager-api-aphxbabxdvd2g5a0.uaenorth-01.azurewebsites.net/api/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Suwan's FundManager to use Face ID for biometric authentication."
      }
    },
    "android": {
      "package": "com.suwan.fundmanager",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#090d16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-updates",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Suwan's FundManager to use Face ID for biometric authentication."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#090d16",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ]
  }
}
